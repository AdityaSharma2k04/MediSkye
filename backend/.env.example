# Database URL (SQLite default for local development; Neon/Postgres for staging/production)
DATABASE_URL=sqlite+aiosqlite:///./mediskye.db

# Redis connection URL (optional; enables centralized token revocation & distributed locks)
REDIS_URL=

# Environment mode: development | staging | production | test
ENV=development
DEBUG=True
PORT=8080

# Google Cloud & Gemini Configuration
GOOGLE_API_KEY=your_gemini_api_key_here
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=global
GOOGLE_GENAI_USE_ENTERPRISE=False

# Google Cloud Storage bucket for RAG index sync (optional)
GCS_INDEX_BUCKET=

# Optional MediSkye API Key for external webhook / API access
MEDISKYE_API_KEY=

# Upload size limits (in megabytes)
MEDISKYE_MAX_UPLOAD_MB=50

# PHI Field-Level Encryption Key (Fernet 32-byte url-safe base64)
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FERNET_KEY=

# Dedicated JWT Secret Signing Key (minimum 32 characters)
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET_KEY=

# Resend API Key for branded transactional verification emails
RESEND_API_KEY=

# Sentry Observability Configuration
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
SENTRY_RELEASE=

# CORS allowed origins (comma-separated). Never use "*" with credentials.
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

