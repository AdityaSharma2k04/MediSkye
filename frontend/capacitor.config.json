{
  "appId": "com.mediskye.app",
  "appName": "MediSkye",
  "webDir": "dist",
  "overrideUserAgent": "Mozilla/5.0 (Linux; Android 14; Pixel 8) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/130.0.0.0 Mobile Safari/537.36",
  "server": {
    "androidScheme": "https"
  },
  "plugins": {
    "StatusBar": {
      "style": "DARK",
      "backgroundColor": "#070B14"
    },
    "SplashScreen": {
      "launchShowDuration": 1200,
      "backgroundColor": "#070B14",
      "showSpinner": false
    }
  }
}

